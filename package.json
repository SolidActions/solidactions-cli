{
  "name": "@solidactions/cli",
  "version": "1.33.0",
  "description": "SolidActions CLI - Deploy and manage workflow automation",
  "main": "dist/index.js",
  "bin": {
    "solidactions": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SolidActions/solidactions-cli.git"
  },
  "homepage": "https://github.com/SolidActions/solidactions-cli",
  "bugs": {
    "url": "https://github.com/SolidActions/solidactions-cli/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "solidactions",
    "cli",
    "workflow",
    "automation",
    "deploy"
  ],
  "scripts": {
    "build": "tsc && cp src/commands/dev-shim.mjs dist/commands/dev-shim.mjs",
    "check:release": "npm run build && npm run test && npm run smoke:init",
    "prepublishOnly": "npm run build",
    "smoke:init": "node scripts/smoke-init.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "archiver": "^7.0.0",
    "axios": "^1.18.1",
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "dotenv": "^17.3.1",
    "form-data": "^4.0.6",
    "fs-extra": "^11.0.0",
    "ignore": "^7.0.5",
    "js-yaml": "^4.3.0",
    "prompts": "^2.4.2",
    "tar": "^7.5.20"
  },
  "devDependencies": {
    "@solidactions/sdk": "^0.7.3",
    "@types/archiver": "^6.0.0",
    "@types/fs-extra": "^11.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/prompts": "^2.4.9",
    "@types/tar": "^6.1.13",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  }
}
